# .gitignore

# 敏感配置
.env
*.env

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
.venv/
env/

# 数据库与本地状态
*.db
*.sqlite3
celery_state.db

# 历史数据备份（含内部路径/校验信息，不入库）
data_backups/

# Celery beat 本地调度状态
celerybeat-schedule*
*.dump
*.rdb
*.snapshot

# 日志文件
logs/
*.log

# IDE 配置
.vscode/
.idea/

# 操作系统文件
.DS_Store
Thumbs.db

# Workbench integration reports contain only disposable synthetic test results.
eval_workbench/results/
