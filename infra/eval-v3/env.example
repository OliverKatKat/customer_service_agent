# Copy to infra/eval-v3/.env; change the password in both lines below.
# This data is local evaluation only. Existing services use 5432/6379/6333.
EVAL_V3_DB_PASSWORD=eval_v3_local_change_me
EVAL_V3_DATABASE_URL=postgresql+asyncpg://eval_v3:eval_v3_local_change_me@127.0.0.1:55432/agent_eval_v3
EVAL_V3_REDIS_URL=redis://127.0.0.1:56379/0
EVAL_V3_QDRANT_URL=http://127.0.0.1:56333
EVAL_V3_COMPANY_KNOWLEDGE_COLLECTION=company_knowledge_eval_v3
EVAL_V3_PASSWORD=replace_with_local_fixture_password_at_least_12_chars
EVAL_V3_APPROVAL_CODE=replace_with_separate_local_approval_code_at_least_16_chars
